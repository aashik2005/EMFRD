# Environment Configuration

# Paths
DATA_DIR=./data
MODELS_DIR=./models
EXPERIMENTS_DIR=./experiments
CACHE_DIR=./data/cache

# Training
DEVICE=cuda  # cuda or cpu
MIXED_PRECISION=true
BATCH_SIZE=8
MAX_EPOCHS=3
LEARNING_RATE=2e-5
RANDOM_SEED=42

# Model
ROBERTA_MODEL=roberta-base
MAX_SEQ_LENGTH=256

# Dataset
PRIMARY_DATASET=fake_reviews
TRAIN_RATIO=0.7
VAL_RATIO=0.15
TEST_RATIO=0.15

# API
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# Logging
LOG_LEVEL=INFO
TENSORBOARD_ENABLED=true
